{
  "uid": "url-shortener-cache",
  "title": "URL Shortener — Redis Cache",
  "tags": ["url-shortener", "redis", "cache"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Cache Operations Rate (ops/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(url_cache_operations_total{application=\"url-shortener\"}[1m])) by (operation)",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 2,
      "title": "Cache Hit Rate %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "100 * sum(rate(url_cache_operations_total{application=\"url-shortener\",operation=~\"hit_positive|hit_negative\"}[1m])) / sum(rate(url_cache_operations_total{application=\"url-shortener\",operation=~\"hit_positive|hit_negative|miss\"}[1m]))",
          "legendFormat": "Cache Hit Rate %"
        },
        {
          "expr": "100 * sum(rate(url_cache_operations_total{application=\"url-shortener\",operation=\"hit_positive\"}[1m])) / sum(rate(url_cache_operations_total{application=\"url-shortener\",operation=~\"hit_positive|hit_negative|miss\"}[1m]))",
          "legendFormat": "Positive Hit Rate %"
        },
        {
          "expr": "100 * sum(rate(url_cache_operations_total{application=\"url-shortener\",operation=\"hit_negative\"}[1m])) / sum(rate(url_cache_operations_total{application=\"url-shortener\",operation=~\"hit_positive|hit_negative|miss\"}[1m]))",
          "legendFormat": "Negative Hit Rate %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 3,
      "title": "Cache Errors Rate (ops/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(url_cache_operations_total{application=\"url-shortener\",operation=\"error\"}[1m])",
          "legendFormat": "Cache Errors/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Cache Errors/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 4,
      "title": "Cache Populate Rate (ops/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(url_cache_operations_total{application=\"url-shortener\",operation=\"populate_positive\"}[1m])",
          "legendFormat": "Positive Populate/s"
        },
        {
          "expr": "rate(url_cache_operations_total{application=\"url-shortener\",operation=\"populate_negative\"}[1m])",
          "legendFormat": "Negative Populate/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 5,
      "title": "Cumulative Cache Operations",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(url_cache_operations_total{application=\"url-shortener\",operation=\"hit_positive\"})",
          "legendFormat": "Positive Hits"
        },
        {
          "expr": "sum(url_cache_operations_total{application=\"url-shortener\",operation=\"hit_negative\"})",
          "legendFormat": "Negative Hits"
        },
        {
          "expr": "sum(url_cache_operations_total{application=\"url-shortener\",operation=\"miss\"})",
          "legendFormat": "Misses"
        },
        {
          "expr": "sum(url_cache_operations_total{application=\"url-shortener\",operation=\"error\"})",
          "legendFormat": "Errors"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["last"] }, "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 6,
      "title": "Click Flush Runs Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(url_click_flush_runs_total{application=\"url-shortener\"}[1m])",
          "legendFormat": "Flush Runs/s"
        },
        {
          "expr": "rate(url_click_flush_urls_total{application=\"url-shortener\"}[1m])",
          "legendFormat": "URLs Flushed/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 7,
      "title": "Click Flush Errors Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(url_click_flush_errors_total{application=\"url-shortener\"}[1m])",
          "legendFormat": "Flush Errors/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Flush Errors/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource"
      }
    ]
  }
}
