{
  "uid": "url-shortener-jvm",
  "title": "URL Shortener — JVM Metrics",
  "tags": ["url-shortener", "jvm"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Heap Memory Used vs Committed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"url-shortener\",area=\"heap\"}",
          "legendFormat": "Heap Used — {{id}}"
        },
        {
          "expr": "jvm_memory_committed_bytes{application=\"url-shortener\",area=\"heap\"}",
          "legendFormat": "Heap Committed — {{id}}"
        },
        {
          "expr": "jvm_memory_max_bytes{application=\"url-shortener\",area=\"heap\"}",
          "legendFormat": "Heap Max — {{id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 2,
      "title": "Non-Heap Memory Used vs Committed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"url-shortener\",area=\"nonheap\"}",
          "legendFormat": "Non-Heap Used — {{id}}"
        },
        {
          "expr": "jvm_memory_committed_bytes{application=\"url-shortener\",area=\"nonheap\"}",
          "legendFormat": "Non-Heap Committed — {{id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 3,
      "title": "GC Pause Duration (p99 per GC)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(jvm_gc_pause_seconds_bucket{application=\"url-shortener\"}[1m])) by (le, action, cause))",
          "legendFormat": "p99 {{action}} / {{cause}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "title": "GC Collections Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(jvm_gc_pause_seconds_count{application=\"url-shortener\"}[1m])) by (action, cause)",
          "legendFormat": "{{action}} / {{cause}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 5,
      "title": "JVM Threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"url-shortener\"}",
          "legendFormat": "Live"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"url-shortener\"}",
          "legendFormat": "Daemon"
        },
        {
          "expr": "jvm_threads_peak_threads{application=\"url-shortener\"}",
          "legendFormat": "Peak"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 6,
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"url-shortener\"}",
          "legendFormat": "Process CPU"
        },
        {
          "expr": "system_cpu_usage{application=\"url-shortener\"}",
          "legendFormat": "System CPU"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 7,
      "title": "Loaded Classes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "jvm_classes_loaded_classes{application=\"url-shortener\"}",
          "legendFormat": "Loaded Classes"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 8,
      "title": "Buffer Pool Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "jvm_buffer_memory_used_bytes{application=\"url-shortener\"}",
          "legendFormat": "Used — {{id}}"
        },
        {
          "expr": "jvm_buffer_total_capacity_bytes{application=\"url-shortener\"}",
          "legendFormat": "Capacity — {{id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource"
      }
    ]
  }
}
